#!/usr/bin/env bash
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 0

bash scripts/rules.sh < /dev/null || exit 1

nothing=0000000000000000000000000000000000000000
status=0
while read -r ref mine where _; do
  [ -n "${mine:-}" ] || continue
  [ "$mine" != "$nothing" ] || continue
  # the name it takes on the remote, which is the one everybody sees
  case ${where:-} in
    refs/heads/*) bash scripts/branches.sh "${where#refs/heads/}" || status=1 ;;
  esac

  # a tag carries no subjects of its own, and it is the last moment to notice that the version
  # it names has nothing to tell the person who installs it
  case ${ref:-} in
    refs/tags/v*)
      bash scripts/news.sh "${ref#refs/tags/v}" || status=1
      continue
      ;;
  esac

  bash scripts/commits.sh "$mine" --not --remotes || status=1
done

exit $status
