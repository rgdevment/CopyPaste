import { Card } from "types.slint";
import { Theme } from "theme.slint";
import { Action } from "cards.slint";
import { Words } from "words.slint";

export component GridCell inherits Rectangle {
    in property <Card> card;
    in property <bool> current;
    callback chosen();
    callback paste();
    callback open-asked();
    callback stirred();
    callback dragged();
    property <bool> dragging;
    border-radius: Theme.radius-card;
    background: current ? Theme.selected : touch.has-hover ? Theme.row-hover : Theme.card;
    animate background { duration: current || touch.has-hover ? 0ms : Theme.let-go; }
    border-width: current ? 2px : 1px;
    border-color: current ? Theme.accent : Theme.panel-border;
    clip: true;
    accessible-role: AccessibleRole.list-item;
    accessible-label: card.title + ", " + card.body;

    touch := TouchArea {
        clicked => { if (!root.dragging) { root.chosen(); } }
        double-clicked => { root.paste(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragging = false;
            }
            if (event.kind == PointerEventKind.move) {
                root.stirred();
                if (touch.pressed && !root.dragging && card.can-drag
                    && (abs(touch.mouse-x - touch.pressed-x) > Theme.drag-start
                        || abs(touch.mouse-y - touch.pressed-y) > Theme.drag-start)) {
                    root.dragging = true;
                    root.dragged();
                }
            }
        }
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        box := Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: transparent;
            property <float> shape: card.thumb.height > 0
                ? card.thumb.width * 1.0 / card.thumb.height
                : 1.0;
            if card.has-thumb && (box.shape > 3.0 || box.shape < 0.34) : Image {
                source: card.thumb;
                width: box.width;
                height: box.height;
                image-fit: contain;
            }
            if card.has-thumb && box.shape <= 3.0 && box.shape >= 1.0 : Image {
                source: card.thumb;
                height: parent.height;
                width: parent.height * box.shape;
                x: (box.width - self.width) / 2;
                y: 0;
                image-fit: fill;
            }
            if card.has-thumb && box.shape < 1.0 && box.shape >= 0.34 : Image {
                source: card.thumb;
                width: box.width;
                height: box.width / box.shape;
                x: 0;
                y: 0;
                image-fit: fill;
            }
            if !card.has-thumb : VerticalLayout {
                alignment: center;
                spacing: 5px;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../assets/icons/image.svg");
                        colorize: card.broken ? Theme.danger : Theme.field-border;
                        width: 22px;
                        height: 22px;
                    }
                }
                Text {
                    text: card.alert;
                    color: Theme.danger;
                    font-size: Theme.fs-caption;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            height: 24px;
            background: Theme.card;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Text {
                    text: card.media-measures;
                    color: Theme.title;
                    font-size: Theme.fs-meta;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                if card.can-open && (touch.has-hover || root.current) : Action {
                    icon: @image-url("../assets/icons/external-link.svg");
                    says: Words.open-it;
                    awake: true;
                    pressed => { root.open-asked(); }
                }
                Text {
                    text: card.source;
                    color: Theme.muted;
                    font-size: Theme.fs-meta;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
