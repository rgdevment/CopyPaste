import { Card } from "types.slint";
import { Theme, Hue } from "theme.slint";

export component FolderBody inherits HorizontalLayout {
    in property <Card> card;
    height: Theme.body-folder;
    spacing: 9px;

    Image {
        source: @image-url("../assets/icons/folder.svg");
        width: 18px;
        height: 18px;
        colorize: Hue.folder;
        y: 0;
    }

    VerticalLayout {
        spacing: 3px;
        horizontal-stretch: 1;
        Text {
            text: card.folder-name;
            color: Theme.body;
            font-size: Theme.fs-body;
            overflow: elide;
            wrap: no-wrap;
        }
        Text {
            text: card.folder-parent;
            color: Theme.muted;
            font-size: Theme.fs-meta;
            overflow: elide;
            wrap: no-wrap;
        }
    }

    if card.folder-said != "" : Text {
        text: card.folder-said;
        color: Theme.muted;
        font-size: Theme.fs-meta;
        vertical-alignment: center;
    }
}
