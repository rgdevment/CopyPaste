export struct Card {
    id: int,
    kind: string,
    title: string,
    source: string,
    times: string,
    age: string,
    body: string,
    squeezed: string,
    shape-root: string,
    shape-said: string,
    shape-keys: string,
    media-clock: string,
    media-measures: string,
    lead: string,
    hit: string,
    tail: string,
    found: bool,
    badge: string,
    alert: string,
    lines: int,
    mono: bool,
    thumb: image,
    has-thumb: bool,
    pinned: bool,
    broken: bool,
}

export struct Chip {
    key: string,
    label: string,
    count: string,
    selected: bool,
}

export struct FormRow {
    key: string,
    label: string,
    preview: string,
}
