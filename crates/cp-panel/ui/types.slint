export struct Card {
    id: int,
    kind: string,
    title: string,
    source: string,
    times: string,
    age: string,
    body: string,
    mono: bool,
    thumb: image,
    has-thumb: bool,
    pinned: bool,
    broken: bool,
}

export struct Chip {
    key: string,
    label: string,
    count: string,
    selected: bool,
}
