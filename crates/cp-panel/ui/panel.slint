import { ListView } from "std-widgets.slint";
import { GridCell } from "bodies_grid.slint";
import { Card, Chip, FormRow } from "types.slint";
import { Theme } from "theme.slint";
import { Words } from "words.slint";
import { Icon, Action, Pill, Tag, CardView, Hue } from "cards.slint";
import { NewerStrip } from "newer.slint";

export { Card, Chip, FormRow, Theme, Words }

export component Panel inherits Window {
    width: Theme.width + Theme.margin * 2;
    height: Theme.height + Theme.margin * 2;
    no-frame: true;
    always-on-top: true;
    background: Theme.apple ? Theme.panel : transparent;
    default-font-family: Theme.font;
    title: "CopyPaste";
    icon: @image-url("../../../app/src-tauri/icons/128x128.png");

    in property <[Card]> cards;
    in property <[int]> grid-lines;
    in property <[Chip]> chips;
    in property <[Chip]> tags;
    in property <[FormRow]> sheet-rows;
    in property <string> sheet-title;
    in-out property <length> sheet-anchor;
    in-out property <length> sheet-span;
    in property <string> sheet-subject;
    in property <string> sheet-kind;
    in property <string> layout: "everything";
    in property <length> shut: Theme.row-plain;
    in property <bool> plain-way;
    in property <bool> one-kind;
    in-out property <bool> keeping;
    callback keep-toggled();
    in property <string> way;
    in property <bool> sheet-narrow;
    in-out property <length> chip-x;
    in property <string> count-text;
    in property <bool> complaining;
    in property <string> way-said;
    in property <string> pinned-count;
    in property <string> empty-title;
    in property <string> empty-hint;
    in property <bool> pinned-on;
    in property <bool> filtered;
    in-out property <string> query;
    in-out property <int> current: -1;
    in-out property <int> naming: -1;
    changed naming => {
        if (root.naming == -1) {
            input.focus();
        }
    }
    in-out property <bool> opened: false;
    in-out property <int> hovered: -1;
    property <int> last-chosen: -1;
    property <duration> last-at;
    property <length> last-x;
    property <length> last-y;
    in-out property <bool> pointer-hidden: false;
    in-out property <bool> quiet: false;
    in-out property <length> rest-x: -1px;
    in-out property <length> rest-y: -1px;
    in-out property <bool> gliding: true;
    in-out property <bool> sheet-open: false;
    in-out property <int> sheet-current: 0;
    in-out property <float> shown: 1.0;
    in-out property <float> fade: 1.0;
    in-out property <length> scroll-y <=> list.content-y;
    in-out property <length> chips-scroll <=> strip.content-x;
    in-out property <length> sheet-at;
    in-out property <bool> sheet-armed: false;
    out property <length> viewport-height: list.visible-height;
    out property <length> list-top: list.absolute-position.y - panel.absolute-position.y;
    out property <length> chips-bottom: strip.absolute-position.y - panel.absolute-position.y
        + strip.height;

    callback search(string);
    callback chip-chosen(string, bool);
    callback ask-ways-for(string);
    callback pin-filter();
    callback drop-tag(string);
    callback clear-filters();
    callback ask-forms(int);
    callback ask-kinds();
    callback ask-settings();
    in property <string> update-line;
    callback update-taken();
    callback update-put-away();
    callback nudge(length, length);
    callback reopened();
    callback to-the-top();
    to-the-top => {
        list.content-y = 0px;
        grid.content-y = 0px;
    }
    callback fresh-start();
    callback emptied();
    callback arrived();
    callback sheet-chosen(string);
    callback paste-as(int, string);
    callback cycle(int);
    callback paste(int);
    callback copy(int);
    callback named(int, string);
    callback pin(int, bool);
    callback remove(int);
    callback open-asked(int);
    callback dismiss();
    callback focus-search();
    callback moved(int);
    callback stirred(int);
    callback dragged(int);

    forward-focus: input;

    focus-search => { input.focus(); }

    changed scroll-y => {
        if (root.sheet-open && root.sheet-armed && abs(root.scroll-y - root.sheet-at) > 12px) {
            root.sheet-open = false;
        }
    }

    panel := Rectangle {
        property <length> sheet-top: root.list-top + root.sheet-anchor + root.sheet-span + list.content-y + 4px;
        x: Theme.margin;
        y: Theme.margin + (1.0 - root.shown) * (Theme.apple ? 0px : 8px);
        width: Theme.width;
        height: Theme.height;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.panel-border;
        background: Theme.panel;
        opacity: Theme.apple ? 1.0 : root.shown;
        drop-shadow-blur: Theme.shadow-blur;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: Theme.apple ? 0px : 10px;
        clip: true;
        animate opacity { duration: Theme.appear; easing: ease-out; }
        animate y { duration: Theme.appear; easing: ease-out; }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            Rectangle {
                height: 14px;
                handle := TouchArea {
                    mouse-cursor: move;
                    moved => {
                        if (handle.pressed) {
                            root.nudge(handle.mouse-x - handle.pressed-x, handle.mouse-y - handle.pressed-y);
                        }
                    }
                }
                Rectangle {
                    width: 34px;
                    height: 3px;
                    border-radius: 2px;
                    background: handle.has-hover ? Theme.muted : Theme.grip;
                    animate background { duration: 120ms; }
                }
            }

            VerticalLayout {
                padding: 10px;
                padding-top: 2px;
                padding-bottom: 8px;
                spacing: 9px;
                if root.update-line != "" : NewerStrip {
                    line: root.update-line;
                    taken => { root.update-taken(); }
                    put-away => { root.update-put-away(); }
                }
                HorizontalLayout {
                    height: 34px;
                    spacing: 8px;
                    alignment: stretch;
                search-box := Rectangle {
                    horizontal-stretch: 1;
                    height: 34px;
                    border-radius: Theme.radius-control;
                    background: Theme.field;
                    border-width: 1px;
                    border-color: input.has-focus ? Theme.focus : Theme.field-border;
                    animate border-color { duration: 100ms; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 9px;
                        alignment: stretch;
                        Icon { source: @image-url("../assets/icons/search.svg"); tint: Theme.placeholder; y: (parent.height - 15px) / 2; }
                        for tag in root.tags : Tag {
                            tag: tag;
                            y: (parent.height - 20px) / 2;
                            dropped(key) => { root.drop-tag(key); }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            input := TextInput {
                                accessible-role: AccessibleRole.text-input;
                                accessible-label: Words.hint;
                                height: parent.height;
                                width: parent.width;
                                vertical-alignment: center;
                                text <=> root.query;
                                color: Theme.body;
                                font-size: Theme.fs-body;
                                single-line: true;
                                edited => { root.search(self.text); }
                                key-pressed(event) => {
                                    if root.sheet-open {
                                        if event.text == Key.Escape {
                                            root.sheet-open = false;
                                            return accept;
                                        }
                                        if event.text == Key.DownArrow {
                                            root.sheet-current = min(root.sheet-current + 1, root.sheet-rows.length - 1);
                                            return accept;
                                        }
                                        if event.text == Key.UpArrow {
                                            root.sheet-current = max(root.sheet-current - 1, 0);
                                            return accept;
                                        }
                                        if event.text == Key.Return {
                                            if (event.modifiers.alt || event.modifiers.control) {
                                                root.sheet-open = false;
                                            } else if (root.sheet-rows.length > 0) {
                                                root.sheet-chosen(root.sheet-rows[root.sheet-current].key);
                                            }
                                            return accept;
                                        }
                                        if event.text == Key.Tab {
                                            root.sheet-open = false;
                                            return accept;
                                        }
                                        if event.text == "1" && root.sheet-rows.length >= 1 {
                                            root.sheet-chosen(root.sheet-rows[0].key);
                                            return accept;
                                        }
                                        if event.text == "2" && root.sheet-rows.length >= 2 {
                                            root.sheet-chosen(root.sheet-rows[1].key);
                                            return accept;
                                        }
                                        if event.text == "3" && root.sheet-rows.length >= 3 {
                                            root.sheet-chosen(root.sheet-rows[2].key);
                                            return accept;
                                        }
                                        if event.text == "4" && root.sheet-rows.length >= 4 {
                                            root.sheet-chosen(root.sheet-rows[3].key);
                                            return accept;
                                        }
                                        if event.text == "5" && root.sheet-rows.length >= 5 {
                                            root.sheet-chosen(root.sheet-rows[4].key);
                                            return accept;
                                        }
                                        if event.text == "6" && root.sheet-rows.length >= 6 {
                                            root.sheet-chosen(root.sheet-rows[5].key);
                                            return accept;
                                        }
                                        if event.text == "7" && root.sheet-rows.length >= 7 {
                                            root.sheet-chosen(root.sheet-rows[6].key);
                                            return accept;
                                        }
                                        if event.text == "8" && root.sheet-rows.length >= 8 {
                                            root.sheet-chosen(root.sheet-rows[7].key);
                                            return accept;
                                        }
                                        if event.text == "9" && root.sheet-rows.length >= 9 {
                                            root.sheet-chosen(root.sheet-rows[8].key);
                                            return accept;
                                        }
                                        root.sheet-open = false;
                                        return reject;
                                    }
                                    if event.text == Key.F1
                                        || (Theme.apple && event.text == "," && event.modifiers.control) {
                                        root.ask-settings();
                                        return accept;
                                    }
                                    if event.text == Key.Return
                                        && root.current >= 0
                                        && (event.modifiers.alt || event.modifiers.control) {
                                        root.ask-forms(root.cards[root.current].id);
                                        return accept;
                                    }
                                    if event.text == Key.Return && root.current >= 0 && event.modifiers.shift {
                                        root.paste-as(root.cards[root.current].id, "plain-text");
                                        return accept;
                                    }
                                    if event.text == Key.Backspace
                                        && !(Theme.apple && event.modifiers.control)
                                        && root.query == ""
                                        && root.tags.length > 0 {
                                        root.drop-tag("");
                                        return accept;
                                    }
                                    if ((!Theme.apple && event.text == Key.Delete)
                                            || (Theme.apple && event.text == Key.Backspace && event.modifiers.control))
                                        && root.query == ""
                                        && root.current >= 0 {
                                        root.remove(root.cards[root.current].id);
                                        return accept;
                                    }
                                    if event.text == "p" && event.modifiers.control && root.current >= 0 {
                                        root.pin(root.cards[root.current].id, !root.cards[root.current].pinned);
                                        return accept;
                                    }
                                    if event.text == "o" && event.modifiers.control && root.current >= 0 {
                                        root.open-asked(root.cards[root.current].id);
                                        return accept;
                                    }
                                    if (event.text == Key.F2 || (event.text == "e" && event.modifiers.control))
                                        && root.current >= 0
                                        && (root.layout != "image" || root.way == "rows") {
                                        root.naming = root.cards[root.current].id;
                                        return accept;
                                    }
                                    if (event.text == "g" || event.text == "t")
                                        && (event.modifiers.alt || (Theme.apple && event.modifiers.control)) {
                                        root.ask-kinds();
                                        return accept;
                                    }
                                    if event.text == "2" && event.modifiers.control {
                                        root.pin-filter();
                                        return accept;
                                    }
                                    if event.text == "1" && event.modifiers.control {
                                        root.clear-filters();
                                        return accept;
                                    }
                                    if event.text == Key.RightArrow && root.current >= 0 {
                                        root.opened = !root.opened;
                                        root.moved(root.current);
                                        return accept;
                                    }
                                    if event.text == Key.Escape {
                                        root.dismiss();
                                        return accept;
                                    }
                                    if event.text == Key.Return && root.current >= 0 {
                                        root.paste(root.cards[root.current].id);
                                        return accept;
                                    }
                                    if event.text == Key.Tab {
                                        root.hovered = -1;
                                        root.cycle(event.modifiers.shift ? -1 : 1);
                                        return accept;
                                    }
                                    if event.text == Key.DownArrow {
                                        root.last-chosen = -1;
                                        if (root.hovered >= 0) {
                                            root.current = root.hovered;
                                        }
                                        root.hovered = -1;
                                        root.pointer-hidden = true;
                                        root.quiet = true;
                                        root.rest-x = -1px;
                                        root.gliding = false;
                                        root.opened = false;
                                        root.sheet-open = false;
                                        root.current = min(root.current + 1, root.cards.length - 1);
                                        root.moved(root.current);
                                        return accept;
                                    }
                                    if event.text == Key.UpArrow {
                                        root.last-chosen = -1;
                                        if (root.hovered >= 0) {
                                            root.current = root.hovered;
                                        }
                                        root.hovered = -1;
                                        root.pointer-hidden = true;
                                        root.quiet = true;
                                        root.rest-x = -1px;
                                        root.gliding = false;
                                        root.opened = false;
                                        root.sheet-open = false;
                                        root.current = root.cards.length == 0 ? -1 : max(root.current - 1, 0);
                                        root.moved(root.current);
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            if root.query == "" : Text {
                                x: 0;
                                height: parent.height;
                                vertical-alignment: center;
                                text: Words.hint;
                                color: Theme.placeholder;
                                font-size: Theme.fs-body;
                            }
                        }
                    }
                }
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            y: (parent.height - 24px) / 2;
                            background: root.keeping
                                ? Theme.accent
                                : keep-touch.has-hover ? Theme.hover : Theme.field;
                            border-width: 1px;
                            border-color: root.keeping ? Theme.accent : Theme.field-border;
                            accessible-role: AccessibleRole.button;
                            accessible-label: root.keeping ? Words.many-kinds : Words.one-kind;
                            accessible-checked: root.keeping;
                            animate background, border-color { duration: 120ms; easing: ease-out; }
                            Icon {
                                source: @image-url("../assets/icons/layers.svg");
                                width: 13px;
                                height: 13px;
                                tint: root.keeping ? Theme.panel : Theme.muted;
                            }
                            keep-touch := TouchArea {
                                clicked => { root.keep-toggled(); }
                            }
                        }
                        pin := Rectangle {
                            width: pin-row.preferred-width;
                            height: 24px;
                            border-radius: 12px;
                            y: (parent.height - 24px) / 2;
                            background: root.pinned-on ? Theme.selected : pin-touch.has-hover ? Theme.hover : Theme.field;
                            border-width: 1px;
                            border-color: root.pinned-on ? Theme.selected-edge : Theme.field-border;
                            accessible-role: AccessibleRole.button;
                            accessible-label: root.pinned-on ? Words.unpin : Words.pin;
                            animate background, border-color { duration: 120ms; easing: ease-out; }
                            pin-row := HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;
                                alignment: center;
                                Icon {
                                    source: @image-url("../assets/icons/pin.svg");
                                    width: 12px;
                                    height: 12px;
                                    tint: root.pinned-on ? Theme.accent : Theme.muted;
                                    y: (parent.height - 12px) / 2;
                                }
                                Text {
                                    text: root.pinned-count;
                                    color: root.pinned-on ? Theme.accent-dim : Theme.muted;
                                    font-size: Theme.fs-caption;
                                    vertical-alignment: center;
                                }
                            }
                            pin-touch := TouchArea {
                                clicked => { root.pin-filter(); }
                            }
                        }
                        if root.filtered : Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            y: (parent.height - 24px) / 2;
                            background: broom-touch.has-hover ? Theme.hover : Theme.field;
                            border-width: 1px;
                            border-color: Theme.field-border;
                            accessible-role: AccessibleRole.button;
                            Icon {
                                source: @image-url("../assets/icons/x.svg");
                                width: 12px;
                                height: 12px;
                                tint: broom-touch.has-hover ? Theme.body : Theme.muted;
                            }
                            broom-touch := TouchArea {
                                clicked => { root.clear-filters(); }
                            }
                        }
                }
                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;
                    alignment: stretch;
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;
                        TouchArea {
                            scroll-event(event) => {
                                strip.content-x = clamp(
                                    strip.content-x + (event.delta-y + event.delta-x) * 1.4,
                                    min(0px, parent.width - strip.content-width),
                                    0px
                                );
                                return accept;
                            }
                            strip := Flickable {
                                width: parent.width;
                                height: 24px;
                                interactive: true;
                                content-width: row.preferred-width;
                                content-height: 24px;
                                row := HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    padding-right: 20px;
                                    for chip in root.chips : Pill {
                                        chip: chip;
                                        chosen(key, adding) => {
                                            root.chip-chosen(key, adding);
                                        }
                                        asked-ways(key) => {
                                            root.chip-x = self.absolute-position.x - panel.absolute-position.x;
                                            root.ask-ways-for(key);
                                        }
                                    }
                                }
                            }
                        }
                        if strip.content-width > strip.width
                            && strip.content-x > strip.width - strip.content-width : Rectangle {
                            x: parent.width - 20px;
                            width: 20px;
                            background: @linear-gradient(90deg, Theme.panel.transparentize(1.0) 0%, Theme.panel 100%);
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                clip: true;
                opacity: root.fade;
                animate opacity { duration: Theme.settle; easing: ease-out; }
                if root.cards.length == 0 : VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/icons/search.svg");
                            colorize: Theme.field-border;
                            width: 30px;
                            height: 30px;
                        }
                    }
                    Text {
                        text: root.empty-title;
                        color: Theme.title;
                        font-size: Theme.fs-body;
                        font-weight: 600;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.empty-hint;
                        color: Theme.muted;
                        font-size: Theme.fs-small;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                wheel := TouchArea {
                    mouse-cursor: root.pointer-hidden ? MouseCursor.none : MouseCursor.default;
                    scroll-event(event) => {
                        root.last-chosen = -1;
                        root.pointer-hidden = false;
                        root.quiet = true;
                        root.rest-x = -1px;
                        root.gliding = true;
                        root.sheet-open = false;
                        root.hovered = -1;
                        root.stirred(-1);
                        list.content-y = clamp(
                            list.content-y + event.delta-y * 1.6,
                            min(0px, list.visible-height - list.content-height),
                            0px
                        );
                        return accept;
                    }
                grid := ListView {
                    accessible-role: AccessibleRole.list;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    visible: root.layout == "image" && root.way != "rows";
                    height: root.layout == "image" && root.way != "rows" ? parent.height : 0px;
                    for line[at] in root.grid-lines : HorizontalLayout {
                        height: Theme.cell;
                        spacing: 8px;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 8px;
                        GridCell {
                            card: root.cards[line * 2];
                            current: root.current == line * 2;
                            chosen => {
                                root.current = line * 2;
                                root.moved(line * 2);
                            }
                            paste => { root.paste(root.cards[line * 2].id); }
                            open-asked => { root.open-asked(root.cards[line * 2].id); }
                            stirred => { root.stirred(line * 2); }
                            dragged => { root.dragged(root.cards[line * 2].id); }
                        }
                        if line * 2 + 1 < root.cards.length : GridCell {
                            card: root.cards[line * 2 + 1];
                            current: root.current == line * 2 + 1;
                            chosen => {
                                root.current = line * 2 + 1;
                                root.moved(line * 2 + 1);
                            }
                            paste => { root.paste(root.cards[line * 2 + 1].id); }
                            open-asked => { root.open-asked(root.cards[line * 2 + 1].id); }
                            stirred => { root.stirred(line * 2 + 1); }
                            dragged => { root.dragged(root.cards[line * 2 + 1].id); }
                        }
                        if line * 2 + 1 >= root.cards.length : Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
                list := ListView {
                    visible: root.layout != "image" || root.way == "rows";
                    height: root.layout != "image" || root.way == "rows" ? parent.height : 0px;
                    accessible-role: AccessibleRole.list;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    animate content-y { duration: root.gliding ? 110ms : 0ms; easing: ease-out; }
                    for card[index] in root.cards : Rectangle {
                        property <bool> mine: index == root.current;
                        init => {
                            if (self.mine) {
                                root.sheet-anchor = self.y;
                                root.sheet-span = self.height;
                            }
                        }
                        changed mine => {
                            if (self.mine) {
                                if (self.y < -list.content-y) {
                                    list.content-y = min(0px, 8px - self.y);
                                } else if (self.y + self.height > -list.content-y + list.visible-height) {
                                    list.content-y = list.visible-height - self.y - self.height - 8px;
                                }
                                root.sheet-anchor = self.y;
                                root.sheet-span = self.height;
                            }
                        }
                        changed height => {
                            if (self.mine) {
                                root.sheet-span = self.height;
                            }
                        }
                        property <bool> open-here: index == root.current && root.opened;
                        height: (card.heads-group ? Theme.row-head : 0px)
                            + (open-here ? card.open-px : card.shut-px);
                        animate height { duration: root.gliding ? Theme.settle : 0ms; easing: ease-out; }
                        VerticalLayout {
                        if card.heads-group : Rectangle {
                            height: Theme.row-head;
                            HorizontalLayout {
                                height: 15px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 7px;
                                Text {
                                    text: card.group-said;
                                    color: Theme.title;
                                    font-size: Theme.fs-meta;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        y: (parent.height - 1px) / 2;
                                        height: 1px;
                                        background: Theme.panel-border;
                                    }
                                }
                            }
                        }
                        CardView {
                            card: card;
                            current: index == root.current;
                            open: index == root.current && root.opened;
                            shown-here: root.hovered >= 0 ? index == root.hovered : index == root.current;
                            plain-way: root.plain-way;
                            one-kind: root.one-kind;
                            quiet: root.quiet;
                            stirred(ax, ay) => {
                                if (root.quiet && root.rest-x < 0px) {
                                    root.rest-x = ax;
                                    root.rest-y = ay;
                                } else if (!root.quiet || abs(ax - root.rest-x) >= Theme.stir || abs(ay - root.rest-y) >= Theme.stir) {
                                    root.quiet = false;
                                    root.rest-x = -1px;
                                    root.pointer-hidden = false;
                                    if (!root.sheet-open) {
                                        root.stirred(index);
                                    }
                                }
                            }
                            dragged(id) => { root.dragged(id); }
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height - (card.heads-group ? Theme.row-head : 0px) - 6px;
                            chosen(id, px, py) => {
                                if (root.last-chosen >= 0 && animation-tick() - root.last-at < Theme.double-click
                                    && (px - root.last-x) * (px - root.last-x) / 1px + (py - root.last-y) * (py - root.last-y) / 1px
                                        < Theme.double-reach * Theme.double-reach / 1px) {
                                    root.paste(root.last-chosen);
                                    root.last-chosen = -1;
                                    return;
                                }
                                root.last-chosen = id;
                                root.last-at = animation-tick();
                                root.last-x = px;
                                root.last-y = py;
                                if (root.sheet-open) {
                                    root.sheet-open = false;
                                } else if (index == root.current) {
                                    root.opened = !root.opened;
                                } else {
                                    root.current = index;
                                    root.opened = true;
                                }
                                root.moved(index);
                            }
                            layout: root.layout;
                            copy(id) => { root.copy(id); }
                            paste(id) => { root.paste(id); }
                            plain(id) => { root.paste-as(id, "plain-text"); }
                            forms(id) => {
                                root.current = index;
                                root.opened = false;
                                root.moved(index);
                                root.ask-forms(id);
                            }
                            naming: root.naming;
                            edit(id) => {
                                root.current = index;
                                root.moved(index);
                                root.naming = id;
                            }
                            named(id, said) => { root.named(id, said); }
                            naming-dropped => { root.naming = -1; }
                            pin(id, on) => { root.pin(id, on); }
                            remove(id) => { root.remove(id); }
                            open-asked(id) => { root.open-asked(id); }
                        }
                        }
                    }
                }
                }
                rail := Rectangle {
                    property <length> anchor;
                    property <length> from;
                    property <length> hidden: min(0px, list.visible-height - list.content-height);
                    property <bool> needed: list.content-height > list.visible-height;
                    property <length> knob-height: needed
                        ? max(30px, list.visible-height * list.visible-height / list.content-height)
                        : 0px;
                    property <length> knob-y: needed
                        ? -list.content-y / list.content-height * list.visible-height
                        : 0px;
                    x: parent.width - 13px;
                    width: 13px;
                    height: parent.height;
                    Rectangle {
                        x: 4px;
                        width: grip.pressed ? 7px : grip.has-hover ? 6px : 5px;
                        y: rail.knob-y;
                        height: rail.knob-height;
                        border-radius: 3px;
                        background: grip.pressed
                            ? Theme.accent-dim
                            : grip.has-hover ? Theme.grip-hover : Theme.grip;
                        opacity: rail.needed ? (grip.pressed ? 1.0 : 0.7) : 0.0;
                        animate background, width, opacity { duration: 120ms; easing: ease-out; }
                    }
                    grip := TouchArea {
                        enabled: rail.needed;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.sheet-open = false;
                                root.gliding = false;
                                if (self.mouse-y < rail.knob-y || self.mouse-y > rail.knob-y + rail.knob-height) {
                                    list.content-y = clamp(
                                        -(self.mouse-y - rail.knob-height / 2) * list.content-height / list.visible-height,
                                        rail.hidden,
                                        0px
                                    );
                                }
                                rail.anchor = self.mouse-y;
                                rail.from = list.content-y;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                list.content-y = clamp(
                                    rail.from - (self.mouse-y - rail.anchor) * list.content-height / list.visible-height,
                                    rail.hidden,
                                    0px
                                );
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: Theme.footer;
                mover := TouchArea {
                    mouse-cursor: move;
                    moved => {
                        if (mover.pressed) {
                            root.nudge(mover.mouse-x - mover.pressed-x, mover.mouse-y - mover.pressed-y);
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: stretch;
                    Icon { source: @image-url("../assets/icons/clipboard.svg"); tint: Theme.muted; y: (parent.height - 15px) / 2; }
                    Text {
                        text: root.count-text;
                        color: root.complaining ? Theme.title : Theme.muted;
                        font-size: Theme.fs-meta;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: root.complaining ? 1 : 0;
                    }
                    if root.way-said != "" && !root.complaining : Text {
                        text: "· " + root.way-said;
                        color: Theme.muted;
                        font-size: Theme.fs-meta;
                        vertical-alignment: center;
                    }
                    if !root.complaining : Rectangle { horizontal-stretch: 1; }
                    if !root.complaining : Rectangle {
                        clip: true;
                        horizontal-stretch: 0;
                        width: min(hints.preferred-width, 230px);
                        hints := HorizontalLayout {
                            spacing: 4px;
                            alignment: end;
                            Icon { source: @image-url("../assets/icons/corner-down-left.svg"); tint: Theme.muted; width: 12px; height: 12px; y: (parent.height - 12px) / 2; }
                            Text { text: root.sheet-open ? Words.sheet-footer : Words.footer; color: Theme.muted; font-size: Theme.fs-caption; vertical-alignment: center; }
                        }
                    }
                    Action {
                        icon: @image-url("../assets/icons/settings.svg");
                        y: (parent.height - 22px) / 2;
                        pressed => { root.ask-settings(); }
                    }
                }
            }
        }

        if root.sheet-open : Rectangle {
            x: root.sheet-narrow
                ? clamp(root.chip-x, 10px, max(10px, parent.width - self.width - 10px))
                : 10px;
            y: clamp(
                root.sheet-narrow ? root.chips-bottom + 6px : panel.sheet-top,
                10px,
                max(10px, parent.height - self.height - 10px)
            );
            width: root.sheet-narrow ? 168px : parent.width - 20px;
            height: min(sheet.preferred-height, parent.height - 20px);
            background: Theme.field;
                border-radius: Theme.radius-card;
                border-width: 1px;
                border-color: Theme.selected-edge;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.scrim;
            drop-shadow-offset-y: 8px;
            clip: true;
            TouchArea {
                scroll-event(event) => {
                    root.sheet-open = false;
                    return accept;
                }
            }
            sheet := VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    HorizontalLayout {
                        height: 22px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: stretch;
                        Text {
                            text: root.sheet-title;
                            color: Theme.muted;
                            font-size: Theme.fs-caption;
                            font-weight: 600;
                            letter-spacing: 0.6px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.sheet-subject != "" : Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 2px;
                            background: Hue.of(root.sheet-kind);
                            y: (parent.height - 6px) / 2;
                        }
                        if root.sheet-subject != "" : Text {
                            text: root.sheet-subject;
                            color: Theme.muted;
                            font-size: Theme.fs-caption;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 170px;
                        }
                    }
                    for form[at] in root.sheet-rows : Rectangle {
                        property <bool> chosen-here: at == root.sheet-current;
                        height: root.sheet-narrow ? 30px : 36px;
                        border-radius: 8px;
                        background: chosen-here ? Theme.selected : row-touch.has-hover ? Theme.row-hover : transparent;
                        animate background { duration: chosen-here || row-touch.has-hover ? 0ms : Theme.let-go; }
                        if chosen-here : Rectangle {
                            x: 0px;
                            y: 7px;
                            width: 3px;
                            height: parent.height - 14px;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }
                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 10px;
                            spacing: 10px;
                            alignment: stretch;
                            if at < 9 : Rectangle {
                                width: 18px;
                                height: 18px;
                                y: (parent.height - 18px) / 2;
                                border-radius: 5px;
                                background: Theme.tile;
                                Text {
                                    text: at + 1;
                                    color: chosen-here ? Theme.accent : Theme.muted;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: form.label;
                                color: chosen-here ? Theme.accent : Theme.body;
                                font-size: Theme.fs-body;
                                vertical-alignment: center;
                                min-width: root.sheet-narrow ? 0px : 140px;
                                overflow: elide;
                            }
                            if form.preview != "" : Text {
                                text: form.preview;
                                color: Theme.muted;
                                font-size: Theme.fs-meta;
                                font-family: Theme.mono-font;
                                vertical-alignment: center;
                                overflow: elide;
                                wrap: no-wrap;
                                horizontal-stretch: 1;
                            }
                            if form.preview == "" : Rectangle { horizontal-stretch: 1; }
                        }
                        row-touch := TouchArea {
                            clicked => { root.sheet-chosen(form.key); }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.move) {
                                    root.sheet-current = at;
                                }
                            }
                        }
                    }
            }
        }
    }
}
