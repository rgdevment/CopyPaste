import { Card, Chip } from "types.slint";
import { LinkBody } from "bodies_link.slint";
import { FolderBody } from "bodies_folder.slint";
import { PapersBody } from "bodies_papers.slint";
import { MediaBody } from "bodies_media.slint";
import { JsonBody } from "bodies.slint";
import { TokenBody } from "bodies_token.slint";
import { Theme } from "theme.slint";
import { Words } from "words.slint";

export component Icon inherits Image {
    in property <color> tint: Theme.muted;
    width: 15px;
    height: 15px;
    colorize: tint;
}

export component Action inherits Rectangle {
    in property <string> says;
    accessible-role: AccessibleRole.button;
    accessible-label: says;
    in property <image> icon;
    in property <color> hot: Theme.body;
    in property <bool> awake: true;
    callback pressed();
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: touch.has-hover ? #333853 : transparent;
    animate background { duration: 100ms; }
    Icon { source: root.icon; width: 14px; height: 14px; tint: touch.has-hover ? root.hot : Theme.muted; }
    touch := TouchArea {
        enabled: root.awake;
        clicked => { root.pressed(); }
    }
}

export component KindIcon inherits Icon {
    in property <string> kind;
    width: 13px;
    height: 13px;
    source: kind == "image" ? @image-url("../assets/icons/image.svg")
        : kind == "json" ? @image-url("../assets/icons/braces.svg")
        : kind == "code" ? @image-url("../assets/icons/code.svg")
        : kind == "link" ? @image-url("../assets/icons/link.svg")
        : kind == "email" ? @image-url("../assets/icons/mail.svg")
        : kind == "phone" ? @image-url("../assets/icons/phone.svg")
        : kind == "color" ? @image-url("../assets/icons/palette.svg")
        : kind == "ip" || kind == "uuid" ? @image-url("../assets/icons/hash.svg")
        : kind == "token" ? @image-url("../assets/icons/key-round.svg")
        : kind == "folder" ? @image-url("../assets/icons/folder.svg")
        : kind == "audio" ? @image-url("../assets/icons/music.svg")
        : kind == "video" ? @image-url("../assets/icons/video.svg")
        : kind == "file" ? @image-url("../assets/icons/file.svg")
        : @image-url("../assets/icons/file-text.svg");
}

export global Hue {
    out property <color> text: Theme.light ? #6366F1 : #A5B4FC;
    out property <color> code: Theme.light ? #0284C7 : #7DD3FC;
    out property <color> json: Theme.light ? #7C3AED : #C4B5FD;
    out property <color> link: Theme.light ? #2563EB : #93C5FD;
    out property <color> email: Theme.light ? #DC2626 : #FCA5A5;
    out property <color> phone: Theme.light ? #CA8A04 : #FCD34D;
    out property <color> paint: Theme.light ? #C026D3 : #F0ABFC;
    out property <color> plain: Theme.light ? #64748B : #94A3B8;
    out property <color> token: Theme.light ? #EA580C : #FDBA74;
    out property <color> image: Theme.light ? #16A34A : #86EFAC;
    out property <color> file: Theme.light ? #737373 : #A3A3A3;
    out property <color> folder: Theme.light ? #D97706 : #FBBF24;
    out property <color> audio: Theme.light ? #DB2777 : #F9A8D4;
    out property <color> video: Theme.light ? #0891B2 : #67E8F9;
    pure public function of(kind: string) -> color {
        return kind == "code" ? self.code
            : kind == "json" ? self.json
            : kind == "link" ? self.link
            : kind == "email" ? self.email
            : kind == "phone" ? self.phone
            : kind == "color" ? self.paint
            : kind == "ip" || kind == "uuid" ? self.plain
            : kind == "token" ? self.token
            : kind == "image" ? self.image
            : kind == "file" ? self.file
            : kind == "folder" ? self.folder
            : kind == "audio" ? self.audio
            : kind == "video" ? self.video
            : self.text;
    }
}

export component Pill inherits Rectangle {
    in property <Chip> chip;
    accessible-role: AccessibleRole.button;
    accessible-label: chip.label;
    callback chosen(string, bool);
    callback asked-ways(string);
    property <bool> shows-arrow: chip.selected && chip.has-ways;
    height: 24px;
    width: content.preferred-width + (shows-arrow ? 16px : 0px);
    border-radius: 12px;
    background: chip.selected ? Theme.selected : touch.has-hover ? #242840 : Theme.field;
    border-width: 1px;
    border-color: chip.selected ? Theme.selected-edge : Theme.field-border;
    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }
    content := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        alignment: center;
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 2px;
            background: Hue.of(chip.key);
            y: (parent.height - 7px) / 2;
        }
        Text { text: chip.label; color: chip.selected ? Theme.accent : Theme.title; font-size: 11.5px; font-weight: 600; vertical-alignment: center; }
        if chip.count != "" : Text { text: chip.count; color: chip.selected ? Theme.accent-dim : Theme.muted; font-size: 10px; vertical-alignment: center; }
    }
    touch := TouchArea {
        property <bool> adding;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.adding = event.modifiers.control;
            }
        }
        clicked => { root.chosen(chip.key, touch.adding); }
    }

    if shows-arrow : Rectangle {
        x: parent.width - 17px;
        width: 17px;
        height: parent.height;
        Image {
            source: @image-url("../assets/icons/chevron-down.svg");
            width: 11px;
            height: 11px;
            colorize: arrow.has-hover ? Theme.body : Theme.accent;
            x: 0;
            y: (parent.height - 11px) / 2;
        }
        arrow := TouchArea {
            clicked => { root.asked-ways(chip.key); }
        }
    }
}

export component Tag inherits Rectangle {
    in property <Chip> tag;
    callback dropped(string);
    height: 20px;
    width: row.preferred-width;
    border-radius: 6px;
    background: Theme.selected;
    border-width: 1px;
    border-color: Theme.selected-edge;
    row := HorizontalLayout {
        padding-left: 7px;
        padding-right: 4px;
        spacing: 4px;
        alignment: center;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 2px;
            background: Hue.of(tag.key);
            y: (parent.height - 6px) / 2;
        }
        Text { text: tag.label; color: Theme.accent; font-size: 11px; font-weight: 600; vertical-alignment: center; }
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            y: (parent.height - 14px) / 2;
            background: close.has-hover ? #3A3F66 : transparent;
            Image {
                source: @image-url("../assets/icons/x.svg");
                width: 9px;
                height: 9px;
                colorize: close.has-hover ? Theme.body : Theme.accent-dim;
            }
            close := TouchArea {
                clicked => { root.dropped(tag.key); }
            }
        }
    }
}

component NameField inherits Rectangle {
    in property <string> seed;
    in property <length> words-size: 12px;
    property <bool> settled;
    callback done(string);
    callback gave-up();
    border-radius: 5px;
    background: Theme.tile;
    border-width: 1px;
    border-color: Theme.accent;
    in property <int> room;
    if root.room > 0 && field.text.character-count > root.room - 12 : Text {
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        text: root.room - field.text.character-count;
        color: field.text.character-count > root.room ? Theme.danger : Theme.muted;
        font-size: 10px;
    }
    field := TextInput {
        accessible-role: AccessibleRole.text-input;
        accessible-label: Words.name-it;
        x: 6px;
        width: parent.width - 34px;
        height: parent.height;
        text: root.seed;
        color: Theme.body;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.panel;
        font-size: root.words-size;
        single-line: true;
        vertical-alignment: center;
        init => {
            self.focus();
            self.select-all();
        }
        accepted => {
            root.settled = true;
            root.done(self.text);
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.settled = true;
                root.gave-up();
                return accept;
            }
            return reject;
        }
        changed has-focus => {
            if (!self.has-focus && !root.settled) {
                root.settled = true;
                root.done(self.text);
            }
        }
    }
}

component KeyChip inherits Rectangle {
    in property <string> keys;
    in property <string> says;
    in property <bool> on;
    height: 22px;
    width: chip-row.preferred-width;
    border-radius: 6px;
    background: on ? Theme.selected : Theme.field;
    border-width: 1px;
    border-color: on ? Theme.selected-edge : Theme.field-border;
    chip-row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        Text { text: root.keys; color: root.on ? Theme.accent : Theme.muted; font-size: 11px; font-weight: 600; vertical-alignment: center; }
        Text { text: root.says; color: root.on ? Theme.accent : Theme.title; font-size: 11px; vertical-alignment: center; }
    }
}

export component CardView inherits Rectangle {
    in property <Card> card;
    in property <string> layout;
    in property <bool> plain-way;
    in property <bool> one-kind;
    property <bool> mixed: !plain-way;
    property <string> shown-as: mixed ? card.kind : layout;
    property <bool> unfolded: mixed && open;
    property <bool> type-body: !mixed && !open;
    property <bool> special: card.paints || (!plain-way && (layout == "json" || layout == "video"
        || layout == "audio" || layout == "papers" || layout == "folder" || layout == "link"));
    in property <bool> current;
    in property <int> naming: -1;
    property <bool> being-named: root.naming == card.id;
    in property <bool> open;
    in property <bool> shown-here;
    in property <bool> quiet;
    callback paste(int);
    callback copy(int);
    callback open-asked(int);
    callback forms(int);
    callback edit(int);
    callback named(int, string);
    callback naming-dropped();
    callback pin(int, bool);
    callback remove(int);
    callback chosen(int);
    callback stirred(length, length);
    callback dragged(int);
    property <bool> dragging;
    property <bool> lit: shown-here;
    property <bool> hovering: touch.has-hover && !quiet;
    accessible-role: AccessibleRole.list-item;
    accessible-label: (card.name != "" ? card.name + ", " : "") + card.title + ", " + card.body;
    border-radius: 12px;
    background: lit ? Theme.selected : hovering ? Theme.row-hover : Theme.card;
    animate background { duration: lit || hovering ? 0ms : Theme.let-go; easing: ease-out; }
    touch := TouchArea {
        clicked => { if (!root.dragging) { root.chosen(card.id); } }
        double-clicked => { root.paste(card.id); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragging = false;
            }
            if (event.kind == PointerEventKind.move) {
                root.stirred(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                if (touch.pressed && !root.dragging && card.can-drag
                    && (abs(touch.mouse-x - touch.pressed-x) > Theme.drag-start
                        || abs(touch.mouse-y - touch.pressed-y) > Theme.drag-start)) {
                    root.dragging = true;
                    root.dragged(card.id);
                }
            }
        }
    }

    if lit : Rectangle {
        x: 0px;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    VerticalLayout {
        padding: 10px;
        padding-top: mixed ? 9px : 10px;
        padding-left: mixed ? 12px : 10px;
        padding-right: mixed ? 12px : 10px;
        spacing: 8px;

        if mixed : VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                height: 22px;
                spacing: 5px;
                if being-named : NameField {
                    seed: card.name;
                    room: Words.name-room;
                    words-size: 11.5px;
                    width: 200px;
                    done(said) => { root.named(card.id, said); }
                    gave-up => { root.naming-dropped(); }
                }
                if !being-named && card.name != "" : Text {
                    text: card.name;
                    color: Theme.body;
                    font-size: 11.5px;
                    font-weight: 600;
                    overflow: elide;
                    wrap: no-wrap;
                    max-width: 180px;
                    vertical-alignment: center;
                }
                if !one-kind : Text {
                    text: card.title;
                    color: Hue.of(card.kind);
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if card.aside-said != "" : Text {
                    text: (one-kind ? "" : "· ") + card.aside-said;
                    color: Theme.muted;
                    font-size: 11px;
                    overflow: elide;
                    wrap: no-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if card.aside-said == "" : Rectangle { horizontal-stretch: 1; }
                if card.badge != "" : Rectangle {
                    width: badge-pill.preferred-width;
                    height: 15px;
                    border-radius: 4px;
                    background: Theme.tile;
                    y: (parent.height - 15px) / 2;
                    badge-pill := HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text { text: card.badge; color: Hue.of(card.kind); font-size: 9.5px; font-weight: 700; vertical-alignment: center; }
                    }
                }
                if card.alert != "" : Rectangle {
                    width: alert-pill.preferred-width;
                    height: 15px;
                    border-radius: 4px;
                    background: Theme.alert-back;
                    y: (parent.height - 15px) / 2;
                    alert-pill := HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text { text: card.alert; color: Theme.alert-ink; font-size: 9.5px; font-weight: 700; vertical-alignment: center; }
                    }
                }
                if card.pinned && !lit && !open : Icon {
                    source: @image-url("../assets/icons/pin.svg");
                    width: 10px;
                    height: 10px;
                    tint: Theme.accent-dim;
                    y: (parent.height - 10px) / 2;
                }
                if !lit && !open : Text {
                    text: card.age;
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                if lit || open : HorizontalLayout {
                    spacing: 2px;
                    alignment: center;
                    if card.can-open && !card.broken : Action { icon: @image-url("../assets/icons/external-link.svg"); says: Words.open-it; pressed => { root.open-asked(card.id); } }
                    Action { icon: @image-url("../assets/icons/pencil.svg"); says: Words.name-it; pressed => { root.edit(card.id); } }
                    if !card.broken : Action { icon: @image-url("../assets/icons/copy.svg"); says: Words.copy-it; pressed => { root.copy(card.id); } }
                    if !card.broken : Action { icon: @image-url("../assets/icons/arrow-right-to-line.svg"); says: Words.paste-as; pressed => { root.forms(card.id); } }
                    Action { icon: card.pinned ? @image-url("../assets/icons/pin-off.svg") : @image-url("../assets/icons/pin.svg"); says: card.pinned ? Words.unpin : Words.pin; pressed => { root.pin(card.id, !card.pinned); } }
                    Action { icon: @image-url("../assets/icons/trash-2.svg"); says: Words.remove; hot: Theme.danger; pressed => { root.remove(card.id); } }
                }
            }

            if !open && card.face == "found" : HorizontalLayout {
                height: 19px;
                Text { text: card.lead; color: Theme.muted; font-size: 13.5px; vertical-alignment: center; }
                Text { text: card.hit; color: Theme.accent; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                Text { text: card.tail; color: Theme.body; font-size: 13.5px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
            }

            if !open && card.face == "thumb" : HorizontalLayout {
                height: 50px;
                spacing: 12px;
                Rectangle {
                    width: 88px;
                    height: 50px;
                    border-radius: 7px;
                    clip: true;
                    background: Theme.tile;
                    Image { source: card.thumb; width: parent.width; height: parent.height; image-fit: cover; }
                    if card.media-clock != "" : Rectangle {
                        x: parent.width - self.width - 4px;
                        y: parent.height - self.height - 4px;
                        width: thumb-clock.preferred-width;
                        height: 15px;
                        border-radius: 4px;
                        background: #000000.with-alpha(0.66);
                        thumb-clock := HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            Text { text: card.media-clock; color: #FFFFFF; font-size: 9.5px; vertical-alignment: center; }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: card.headline; color: Theme.body; font-size: 13.5px; overflow: elide; wrap: no-wrap; }
                    if card.media-measures != "" && card.media-measures != card.headline : Text {
                        text: card.media-measures;
                        color: Theme.muted;
                        font-size: 11px;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }

            if !open && card.face == "paint" : HorizontalLayout {
                height: 24px;
                spacing: 10px;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 6px;
                    background: card.paint;
                    border-width: 1px;
                    border-color: Theme.selected-edge;
                }
                Text {
                    text: card.squeezed;
                    color: Theme.body;
                    font-size: 13px;
                    font-family: "Cascadia Mono";
                    overflow: elide;
                    wrap: no-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }

            if !open && card.face == "block" : Rectangle {
                height: 12px + card.shut-lines * 17px;
                border-radius: 6px;
                background: Theme.tile;
                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    Text { text: card.line-one; height: 17px; color: Theme.mono; font-size: 12px; font-family: "Cascadia Mono"; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
                    if card.shut-lines > 1 : Text { text: card.line-two; height: 17px; color: Theme.mono; font-size: 12px; font-family: "Cascadia Mono"; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
                }
            }

            if !open && card.face == "keys" : Text {
                text: card.shape-keys;
                height: card.shut-lines * 16px;
                color: Theme.mono;
                font-size: 11.5px;
                font-family: "Cascadia Mono";
                wrap: word-wrap;
                overflow: elide;
            }

            if !open && card.face == "link" : HorizontalLayout {
                height: 19px;
                if layout != "link" : Text { text: card.link-domain; color: Theme.body; font-size: 13.5px; font-weight: 600; wrap: no-wrap; vertical-alignment: center; }
                Text { text: card.link-path; color: layout == "link" ? Theme.body : Theme.muted; font-size: 13px; overflow: elide; wrap: no-wrap; horizontal-stretch: 1; vertical-alignment: center; }
            }

            if !open && (card.face == "file" || card.face == "media") : HorizontalLayout {
                height: 34px;
                spacing: 10px;
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 7px;
                    background: Theme.tile;
                    if card.papers-format != "" : Text {
                        text: card.papers-format;
                        color: Hue.of(card.kind);
                        font-size: 9.5px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if card.papers-format == "" : KindIcon {
                        kind: card.kind;
                        width: 16px;
                        height: 16px;
                        tint: Hue.of(card.kind);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: card.folder-name != "" ? card.folder-name : card.headline;
                        color: card.broken ? Theme.danger : Theme.body;
                        font-size: 13.5px;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                    if card.folder-parent != "" || card.media-measures != "" : Text {
                        text: card.folder-parent != "" ? card.folder-parent : card.media-measures;
                        color: Theme.muted;
                        font-size: 11px;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }

            if !open && card.face == "words" : Text {
                text: card.squeezed;
                height: card.shut-lines * 19px;
                color: card.broken ? Theme.danger : Theme.body;
                font-size: 13.5px;
                wrap: word-wrap;
                overflow: elide;
            }

            if open && card.face == "thumb" : Rectangle {
                height: 146px;
                border-radius: 8px;
                clip: true;
                background: Theme.tile;
                Image { source: card.thumb; width: parent.width; height: parent.height; image-fit: contain; }
            }
            if open && card.face == "thumb" : Text {
                height: 15px;
                text: card.media-measures != "" ? card.media-measures : card.headline;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
                wrap: no-wrap;
            }

            if open && (card.face == "words" || card.face == "found") : Text {
                text: card.opened;
                height: card.open-lines * 19px;
                color: card.broken ? Theme.danger : Theme.body;
                font-size: 13.5px;
                wrap: word-wrap;
                overflow: elide;
            }

            if open && card.claims : Rectangle {
                height: 12px + card.claim-rows * 17px;
                border-radius: 6px;
                background: Theme.tile;
                TokenBody {
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    height: parent.height - 12px;
                    card: card;
                }
            }

            if open && !card.claims && (card.face == "block" || card.face == "keys" || card.face == "link") : Rectangle {
                height: 12px + card.open-lines * 17px;
                border-radius: 6px;
                background: Theme.tile;
                Text {
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    height: parent.height - 12px;
                    text: card.opened;
                    color: Theme.mono;
                    font-size: 12px;
                    font-family: "Cascadia Mono";
                    wrap: card.face == "link" ? char-wrap : no-wrap;
                    overflow: elide;
                }
            }

            if open && card.more-said != "" : Text {
                height: 15px;
                text: card.more-said;
                color: Theme.muted;
                font-size: 11px;
            }

            if open && card.face == "paint" : HorizontalLayout {
                height: 48px;
                spacing: 12px;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 9px;
                    background: card.paint;
                    border-width: 1px;
                    border-color: Theme.selected-edge;
                }
                Text {
                    text: card.squeezed;
                    color: Theme.body;
                    font-size: 14px;
                    font-family: "Cascadia Mono";
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            if open && card.face == "file" && card.kind == "folder" : FolderBody { card: card; }
            if open && card.face == "file" && card.kind != "folder" : PapersBody { card: card; }
            if open && card.face == "media" : MediaBody { card: card; }

            if open && !card.broken : HorizontalLayout {
                height: 22px;
                spacing: 6px;
                KeyChip { keys: "⏎"; says: Words.paste-it; on: true; }
                KeyChip { keys: "⇧⏎"; says: Words.paste-plain; }
                KeyChip { keys: Theme.apple ? "⌥⏎" : "Alt ⏎"; says: Words.paste-as-short; }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        if !mixed && card.has-thumb : Rectangle {
            height: 96px;
            border-radius: 8px;
            clip: true;
            background: transparent;
            Image { source: card.thumb; width: parent.width; height: parent.height; image-fit: contain; }

            if card.media-clock != "" : Rectangle {
                x: parent.width - self.width - 6px;
                y: parent.height - self.height - 6px;
                width: clock-row.preferred-width;
                height: 18px;
                border-radius: 4px;
                background: #000000.with-alpha(0.66);
                clock-row := HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: card.media-clock;
                        color: #FFFFFF;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if !mixed && !card.has-thumb && card.found && !open : HorizontalLayout {
            height: 18px;
            spacing: 0px;
            alignment: start;
            Text { text: card.lead; color: Theme.muted; font-size: 12.5px; vertical-alignment: center; }
            Text { text: card.hit; color: Theme.accent; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
            Text { text: card.tail; color: Theme.body; font-size: 12.5px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
        }

        if !mixed && card.paints && !card.has-thumb && !open : HorizontalLayout {
            spacing: 9px;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 7px;
                background: card.paint;
                border-width: 1px;
                border-color: Theme.selected-edge;
                y: 0;
            }
            Text {
                text: card.squeezed;
                color: Theme.body;
                font-size: 12.5px;
                font-family: "Cascadia Mono";
                horizontal-stretch: 1;
                overflow: elide;
                wrap: no-wrap;
                vertical-alignment: center;
            }
        }

        if !card.has-thumb && type-body && !plain-way && shown-as == "json" : JsonBody {
            card: card;
        }

        if !card.has-thumb && type-body && !plain-way && (shown-as == "video" || shown-as == "audio") : MediaBody {
            card: card;
        }

        if !card.has-thumb && type-body && !plain-way && (shown-as == "papers" || shown-as == "file") : PapersBody {
            card: card;
        }

        if !card.has-thumb && type-body && !plain-way && shown-as == "folder" : FolderBody {
            card: card;
        }

        if !card.has-thumb && type-body && !plain-way && shown-as == "link" : LinkBody {
            card: card;
        }

        if !mixed && !card.has-thumb && (!card.found || open) && !(special && !open) : Text {
            text: open ? card.body : card.squeezed;
            color: card.mono ? Theme.mono : Theme.body;
            font-size: card.mono ? 12px : 13px;
            font-family: card.mono ? "Cascadia Mono" : "Segoe UI";
            overflow: elide;
            height: open ? (card.claims ? Theme.line : card.body-lines * Theme.line) : 36px;
            wrap: card.claims && open ? no-wrap : (card.mono ? char-wrap : word-wrap);
        }

        if !mixed && card.claims && open : TokenBody { card: card; }

        if !mixed : HorizontalLayout {
            height: 16px;
            spacing: 6px;
            alignment: stretch;
            if card.badge != "" : Rectangle {
                width: badge-row.preferred-width;
                height: 15px;
                border-radius: 4px;
                background: Theme.tile;
                y: (parent.height - 15px) / 2;
                badge-row := HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text { text: card.badge; color: Theme.muted; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
                }
            }
            if card.alert != "" : Rectangle {
                width: alert-row.preferred-width;
                height: 15px;
                border-radius: 4px;
                background: Theme.alert-back;
                y: (parent.height - 15px) / 2;
                alert-row := HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text { text: card.alert; color: Theme.alert-ink; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
                }
            }
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 2px;
                background: Hue.of(card.kind);
                y: (parent.height - 7px) / 2;
            }
            if being-named : NameField {
                seed: card.name;
                room: Words.name-room;
                words-size: 11px;
                width: 160px;
                done(said) => { root.named(card.id, said); }
                gave-up => { root.naming-dropped(); }
            }
            if !being-named : Text {
                text: card.name != "" ? card.name : card.title;
                color: card.broken ? Theme.danger : Theme.title;
                font-size: 11px;
                font-weight: 600;
                overflow: elide;
                wrap: no-wrap;
                vertical-alignment: center;
            }
            if card.source != "" : Text { text: "· " + card.source; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            if card.times != "" : Text { text: "×" + card.times; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            if card.pinned : Icon { source: @image-url("../assets/icons/pin.svg"); width: 10px; height: 10px; tint: Theme.accent-dim; y: (parent.height - 10px) / 2; }
            Rectangle { horizontal-stretch: 1; }
            HorizontalLayout {
                spacing: 2px;
                alignment: center;
                opacity: lit ? 1.0 : 0.0;
                animate opacity { duration: 120ms; easing: ease-out; }
                if card.can-open && !card.broken : Action { icon: @image-url("../assets/icons/external-link.svg"); says: Words.open-it; awake: lit; pressed => { root.open-asked(card.id); } }
                Action { icon: @image-url("../assets/icons/pencil.svg"); says: Words.name-it; awake: lit; pressed => { root.edit(card.id); } }
                if !card.broken : Action { icon: @image-url("../assets/icons/copy.svg"); says: Words.copy-it; awake: lit; pressed => { root.copy(card.id); } }
                if !card.broken : Action { icon: @image-url("../assets/icons/arrow-right-to-line.svg"); says: Words.paste-as; awake: lit; pressed => { root.forms(card.id); } }
                Action { icon: card.pinned ? @image-url("../assets/icons/pin-off.svg") : @image-url("../assets/icons/pin.svg"); says: card.pinned ? Words.unpin : Words.pin; awake: lit; pressed => { root.pin(card.id, !card.pinned); } }
                Action { icon: @image-url("../assets/icons/trash-2.svg"); says: Words.remove; hot: Theme.danger; awake: lit; pressed => { root.remove(card.id); } }
            }
            Text { text: card.age; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
        }
    }
}
