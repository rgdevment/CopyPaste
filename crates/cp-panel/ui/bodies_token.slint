import { Card } from "types.slint";
import { Theme } from "theme.slint";

export component TokenBody inherits HorizontalLayout {
    in property <Card> card;
    spacing: 12px;
    alignment: start;
    accessible-role: AccessibleRole.text;
    accessible-label: card.claims-spoken;

    Text {
        accessible-role: AccessibleRole.none;
        text: card.claim-names;
        color: Theme.muted;
        font-family: "Cascadia Mono";
        font-size: 11.5px;
        wrap: no-wrap;
    }

    Text {
        accessible-role: AccessibleRole.none;
        text: card.claim-values;
        color: Theme.body;
        font-family: "Cascadia Mono";
        font-size: 11.5px;
        wrap: no-wrap;
        overflow: elide;
        horizontal-stretch: 1;
    }
}
