import { Card } from "types.slint";
import { Theme } from "theme.slint";

export global Paper {
    out property <color> sheets: Theme.light ? #137238 : #6FCF97;
    out property <color> words: Theme.light ? #1D4ED8 : #7FA9F0;
    out property <color> slides: Theme.light ? #A64D0A : #FCD34D;
    out property <color> pages: Theme.light ? #B91C1C : #F28B82;
    out property <color> plain: Theme.light ? #63636C : #9EA0A8;
    pure public function of(family: string) -> color {
        return family == "sheets" ? self.sheets
            : family == "words" ? self.words
            : family == "slides" ? self.slides
            : family == "pages" ? self.pages
            : self.plain;
    }
}

export component PapersBody inherits HorizontalLayout {
    in property <Card> card;
    height: Theme.body-papers;
    spacing: 9px;

    Rectangle {
        width: 34px;
        height: 34px;
        border-radius: 7px;
        background: Paper.of(card.papers-family).transparentize(0.86);
        y: 0;
        if card.papers-format != "" : Text {
            text: card.papers-format;
            color: Paper.of(card.papers-family);
            font-size: Theme.fs-caption;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if card.papers-format == "" : Image {
            source: @image-url("../assets/icons/file.svg");
            width: 16px;
            height: 16px;
            colorize: Paper.plain;
        }
    }

    HorizontalLayout {
        spacing: 6px;
        horizontal-stretch: 1;
        alignment: start;

        Text {
            text: card.folder-name != "" ? card.folder-name : card.squeezed;
            color: Theme.body;
            font-size: Theme.fs-body;
            overflow: elide;
            wrap: no-wrap;
            vertical-alignment: center;
        }

        if card.folder-parent != "" : Text {
            text: card.folder-parent;
            color: Theme.muted;
            font-size: Theme.fs-meta;
            horizontal-stretch: 1;
            overflow: elide;
            wrap: no-wrap;
            vertical-alignment: center;
        }
    }
}
