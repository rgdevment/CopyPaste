import { Card } from "types.slint";
import { Theme } from "theme.slint";

export component JsonBody inherits VerticalLayout {
    in property <Card> card;
    spacing: 7px;

    HorizontalLayout {
        height: 16px;
        spacing: 7px;
        alignment: start;
        Rectangle {
            width: root-row.preferred-width;
            height: 16px;
            border-radius: 4px;
            background: Theme.field;
            root-row := HorizontalLayout {
                padding-left: 5px;
                padding-right: 5px;
                Text {
                    text: card.shape-root;
                    color: Theme.accent;
                    font-family: "Cascadia Mono";
                    font-size: 10.5px;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: card.shape-said;
            color: Theme.title;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    Text {
        text: card.shape-keys;
        color: Theme.muted;
        font-family: "Cascadia Mono";
        font-size: 11.5px;
        wrap: word-wrap;
        overflow: elide;
        height: 36px;
    }
}
