export global Theme {
    in-out property <bool> light: false;
    out property <bool> apple: Platform.os == OperatingSystemType.macos;
    in-out property <string> font: apple ? "System Font" : "Segoe UI";
    in-out property <string> mono-font: apple ? "Menlo" : "Consolas";
    in-out property <float> zoom: 1;
    in-out property <color> panel: light ? #F7F8FB : #1A1D2B;
    out property <color> panel-border: light ? #DCDEE8 : #262A3C;
    out property <color> footer: light ? #EEF0F5 : #1B1E2C;
    out property <color> card: light ? #FFFFFF : #1E2132;
    out property <color> card-edge: transparent;
    out property <color> row-hover: light ? #EEF0F6 : #242840;
    out property <color> field: light ? #FFFFFF : #1F2234;
    out property <color> field-border: light ? #D0D3E0 : #2A2E44;
    out property <color> tile: light ? #EEF0F6 : #262A40;
    out property <color> hover: light ? #1418301F : #333853;
    out property <color> pressed: light ? #14183029 : #3A3F66;
    in-out property <color> grip: light ? #B4B1EC : #4A5085;
    out property <color> grip-hover: light ? #6B6D7A : #8E90A0;
    out property <color> body: light ? #3A3D4A : #D6D7DA;
    out property <color> title: light ? #3A3D4A : #BCBDC2;
    out property <color> mono: light ? #3A3D4A : #C3C5CC;
    out property <color> muted: light ? #6B6D7A : #8E90A0;
    out property <color> placeholder: light ? #8A8C99 : #6D6F7B;
    in-out property <color> accent: light ? #4F46E5 : #A5B4FC;
    in-out property <color> accent-dim: light ? #6B63EA : #7C86C9;
    in-out property <color> focus: light ? #6B63EA : #7C86C9;
    in-out property <color> selected: light ? #E9E9FB : #282C46;
    in-out property <color> selected-edge: light ? #B4B1EC : #4A5085;
    out property <color> danger: light ? #C0392B : #F28B82;
    out property <color> alert-back: light ? #FDE9B5 : #46351C;
    out property <color> alert-ink: light ? #7A4E07 : #FCD34D;
    out property <color> scrim: #000000A6;
    out property <color> shadow: light ? #0000002E : #00000099;
    in-out property <length> shadow-blur: apple ? 0px : 22px;
    out property <length> radius: apple ? 0px : 8px;
    out property <length> margin: apple ? 0px : 18px;
    out property <length> radius-card: 10px;
    out property <length> radius-control: 8px;
    out property <length> radius-inset: 6px;
    out property <length> radius-badge: 4px;
    out property <length> fs-caption: 10px;
    out property <length> fs-meta: 11px;
    out property <length> fs-small: 12px;
    out property <length> fs-body: 13px;
    out property <int> fw-title: 600;
    out property <length> row-thumb: 146px;
    out property <length> row-plain: 86px;
    out property <length> row-mixed: 60px;
    out property <length> body-json: 59px;
    out property <length> body-link: 36px;
    out property <length> body-folder: 36px;
    out property <length> body-papers: 40px;
    out property <length> body-media: 36px;
    out property <length> row-json: 112px;
    out property <length> row-head: 23px;
    out property <length> cell: 184px;
    out property <length> row-found: 68px;
    out property <length> row-frame: 50px;
    out property <length> line: 18px;
    out property <length> width: 480px;
    out property <length> height: 620px;
    out property <length> drag-start: 6px;
    out property <duration> double-click: 500ms;
    out property <length> double-reach: 10px;
    out property <duration> appear: 120ms;
    out property <duration> settle: 150ms;
    out property <duration> let-go: 90ms;
    out property <length> stir: 3px;
}

export global Hue {
    out property <color> text: Theme.light ? #4F46E5 : #A5B4FC;
    out property <color> code: Theme.light ? #0369A1 : #7DD3FC;
    out property <color> json: Theme.light ? #7C3AED : #C4B5FD;
    out property <color> link: Theme.light ? #1D4ED8 : #93C5FD;
    out property <color> email: Theme.light ? #B91C1C : #FCA5A5;
    out property <color> phone: Theme.light ? #92570A : #FCD34D;
    out property <color> paint: Theme.light ? #A21CAF : #F0ABFC;
    out property <color> plain: Theme.light ? #475569 : #94A3B8;
    out property <color> token: Theme.light ? #B83D0B : #FDBA74;
    out property <color> image: Theme.light ? #137238 : #86EFAC;
    out property <color> file: Theme.light ? #525252 : #A3A3A3;
    out property <color> folder: Theme.light ? #A64D0A : #FBBF24;
    out property <color> audio: Theme.light ? #BE185D : #F9A8D4;
    out property <color> video: Theme.light ? #0E7490 : #67E8F9;
    pure public function of(kind: string) -> color {
        return kind == "code" ? self.code
            : kind == "json" ? self.json
            : kind == "link" ? self.link
            : kind == "email" ? self.email
            : kind == "phone" ? self.phone
            : kind == "color" ? self.paint
            : kind == "ip" || kind == "uuid" ? self.plain
            : kind == "token" ? self.token
            : kind == "image" ? self.image
            : kind == "file" ? self.file
            : kind == "folder" ? self.folder
            : kind == "audio" ? self.audio
            : kind == "video" ? self.video
            : self.text;
    }
}
