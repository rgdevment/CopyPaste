export global Theme {
    in-out property <color> panel: #1A1D2B;
    out property <color> panel-border: #262A3C;
    out property <color> field: #1F2234;
    out property <color> field-border: #2A2E44;
    out property <color> card: #1E2132;
    out property <color> card-hover: #252940;
    out property <color> tile: #262A40;
    out property <color> title: #BCBDC2;
    out property <color> body: #D6D7DA;
    out property <color> mono: #C3C5CC;
    out property <color> muted: #83858E;
    out property <color> placeholder: #6D6F7B;
    out property <color> accent: #A5B4FC;
    out property <color> accent-dim: #7C86C9;
    out property <color> selected: #282C46;
    out property <color> selected-edge: #3A3F66;
    out property <color> footer: #1B1E2C;
    out property <color> danger: #F28B82;
    out property <color> shadow: #00000099;
    in-out property <length> shadow-blur: 22px;
    out property <length> radius: 16px;
    out property <length> margin: 18px;
    out property <length> row-thumb: 146px;
    out property <length> row-plain: 86px;
    out property <length> row-found: 68px;
    out property <length> row-frame: 50px;
    out property <length> line: 18px;
    out property <length> width: 440px;
    out property <length> height: 540px;
    out property <duration> appear: 120ms;
    out property <duration> settle: 150ms;
}
